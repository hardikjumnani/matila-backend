# ===========================================================================
# Environment configuration — EXAMPLE / TEMPLATE
# ===========================================================================
# Copy this file to `.env` for local development and fill in real values.
#
# NEVER commit a populated `.env` or a Firebase service-account file. In
# production these values are supplied through the hosting platform's
# environment variable system, not through a committed file.
#
# Every variable the settings read is documented here. Optional variables list
# their default in a comment; required variables (no default) must be set.
# ===========================================================================

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# REQUIRED. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret

# Optional (default: False). MUST remain False/absent in production.
DJANGO_DEBUG=True

# Optional in dev (default: localhost,127.0.0.1). REQUIRED in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Which settings module to load: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# ---------------------------------------------------------------------------
# Logging (optional; default: INFO)
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
# If unset, development falls back to SQLite. This fallback exists only so the
# project boots before infra is provisioned — DEVELOP AGAINST POSTGRES once it
# is available, since SQLite does not reproduce JSONField behavior or the
# row-locking (SELECT ... FOR UPDATE SKIP LOCKED) matchmaking relies on.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anonymous_chat
# Optional (default: 60). Persistent connection lifetime in seconds.
DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Redis — cache, Channels channel layer, Celery broker/result backend
# ---------------------------------------------------------------------------
# Format: redis://[:PASSWORD@]HOST:6379/0
# If unset, development uses in-memory cache + channel layer (single-process).
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Celery (optional — default to REDIS_URL / sensible limits)
# ---------------------------------------------------------------------------
# Override only to use a broker distinct from the cache Redis (e.g. a separate
# database index or instance).
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# CELERY_TASK_TIME_LIMIT=300
# CELERY_TASK_SOFT_TIME_LIMIT=270

# ---------------------------------------------------------------------------
# Firebase Admin SDK (authentication + push notifications)
# ---------------------------------------------------------------------------
# REQUIRED in production. Absolute path to the service-account JSON file.
# Used both for verifying Firebase ID tokens and for sending FCM push
# notifications via the HTTP v1 API (firebase_admin.messaging).
#
# NOTE: There is deliberately no FCM_SERVER_KEY. Google shut down the legacy
# FCM server-key API in June 2024; push delivery uses the Admin SDK with the
# credentials below.
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-credentials.json
# Optional (default 10): ID-token clock-skew tolerance in seconds (0-60). Raise
# only if a dev machine's clock is off and cannot reach NTP.
FIREBASE_TOKEN_CLOCK_SKEW_SECONDS=10

# ---------------------------------------------------------------------------
# AWS S3 (private media: profile photos, college IDs, gesture selfies, images)
# ---------------------------------------------------------------------------
# REQUIRED in production (bucket + region). If AWS_STORAGE_BUCKET_NAME is unset,
# development stores media on the local filesystem under ./media.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# Optional: omit on EC2/ECS to use the instance IAM role instead of static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional (default: 3600). Signed-URL lifetime in seconds for private media.
AWS_QUERYSTRING_EXPIRE=3600

# ---------------------------------------------------------------------------
# Razorpay (payments)
# ---------------------------------------------------------------------------
# REQUIRED in production. Webhook secret is set in the Razorpay dashboard and
# is separate from the API key secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# CORS / CSRF
# ---------------------------------------------------------------------------
# Comma-separated origins. CORS_ALLOWED_ORIGINS is REQUIRED in production.
# The native Flutter client does not need CORS, but the browsable API/admin do.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Development only: allow any origin (default: True in development settings).
CORS_ALLOW_ALL_ORIGINS=True

# ---------------------------------------------------------------------------
# Uploads (optional; default: 10 MB)
# ---------------------------------------------------------------------------
# Maximum accepted request body / in-memory upload size, in bytes.
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# ---------------------------------------------------------------------------
# Production security (optional; default: 31536000 = 1 year)
# ---------------------------------------------------------------------------
# SECURE_HSTS_SECONDS=31536000
