# ===========================================================================
# Environment configuration — EXAMPLE / TEMPLATE
# ===========================================================================
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit a populated `.env`. Production values are supplied through the
# hosting platform's environment variable system, not through a committed file.
#
# Step 1 defines the core Django/database/cache variables required to boot the
# project. Step 2 (Environment & Configuration Setup) adds the integration
# credentials (Firebase, AWS S3, Razorpay, FCM, Celery).
# ===========================================================================

# --- Django core -----------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Logging ---------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# --- Database (PostgreSQL) -------------------------------------------------
# Example: postgres://USER:PASSWORD@HOST:5432/DBNAME
# Leave unset locally to fall back to SQLite (development convenience only).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anonymous_chat
DB_CONN_MAX_AGE=60

# --- Redis (cache, channel layer, Celery broker) ---------------------------
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
