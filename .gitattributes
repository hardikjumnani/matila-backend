# Normalize line endings across Windows (dev) and Linux (production).
# Text files are stored with LF in the repository; Git handles the working-copy
# conversion. This prevents spurious CRLF/LF diffs between platforms.
* text=auto eol=lf

# Explicit text types (defensive; covers files Git might not auto-detect).
*.py     text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.env*   text eol=lf

# Binary types (never normalize).
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
